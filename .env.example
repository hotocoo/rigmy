# RigMY environment variables (copy to .env and adjust).
# Nothing here is required for local development: the web app rewrites /api/*
# to http://localhost:8787 by default, and the API defaults are in
# docs/BACKEND.md (RIGMY_DB, RIGMY_CONFIG, PORT, HOST, RIGMY_CORS_ORIGINS).

# --- web (Next.js) ---
# Where the browser-side /api/* rewrite forwards. Must be reachable from the
# web server process (not the browser) when the web app is served separately.
RIGMY_API_URL=http://localhost:8787

# --- rigmy-api ---
# RIGMY_DB=rigmy.db
# RIGMY_CONFIG=config
# PORT=8787
# HOST=127.0.0.1
# RIGMY_CORS_ORIGINS=http://localhost:3000
# RUST_LOG=info

# --- docker (docker/ + Dockerfiles) ---
# RIGMY_IMAGE_API=ghcr.io/hotocoo/rigmy-api:latest
# RIGMY_IMAGE_WEB=ghcr.io/hotocoo/rigmy-web:latest
